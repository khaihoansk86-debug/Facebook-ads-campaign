NOTION_TOKEN=ntn_xxx
NOTION_DATA_SOURCE_ID=your_notion_data_source_id
NOTION_DATABASE_ID=
PARENT_PAGE_ID=
SAMPLE_CSV=sample/facebook_ads_template.csv
TEMPLATE_ROW_INDEX=0

# Không bắt buộc. Điền nếu muốn nhận thông báo sau khi export.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
READY_STATUS_NAMES=Ready,To-do,Not started
EXPORTED_STATUS_NAMES=Done,Complete,Exported

# Không dùng trong frontend. Chỉ dùng cho desktop tool/backend sync dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADS_SYNC_TOKEN=

# Meta Marketing API. Token chỉ đặt ở backend, tuyệt đối không đưa vào Vercel/frontend.
META_ACCESS_TOKEN=
META_API_VERSION=v25.0
META_AD_ACCOUNT_ID=act_123456789
META_PAGE_ID=123456789
META_TEST_MODE=true
# Ánh xạ từng bundle Planner sang một ad set mẫu đã chạy đúng trên Meta.
META_ADSET_TEMPLATE_MAP={"ENG_POST_COLD":"123456789"}
# Chỉ bật fallback này khi tất cả bundle thật sự dùng chung cấu hình tối ưu của một mẫu.
META_TEMPLATE_ADSET_ID=
META_ALLOW_DEFAULT_TEMPLATE=false

# Quyền IT/Ads Operator. Dùng chuỗi bí mật dài, riêng biệt và chỉ lưu ở backend.
PLANNER_APPROVER_KEY=
# Khuyến nghị đặt chuỗi ngẫu nhiên khác với khóa người duyệt để ký cookie phiên.
PLANNER_SESSION_SECRET=
# Không bắt buộc. Mặc định lưu tại .web_state/planner_reviews.json.
PLANNER_REVIEW_STORE=

# Không bắt buộc. Nhật ký thao tác ghi qua MCP; mặc định .web_state/mcp_audit.jsonl.
MCP_AUDIT_LOG=
